generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  KARYAWAN
  MANAGER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  password String
  role Role @default(KARYAWAN)
  lokasiId String?
  createdAt DateTime @default(now())
  requests Request[]
  lokasi Lokasi? @relation(fields: [lokasiId], references: [id])
}

model Lokasi {
  id String @id @default(cuid())
  nama String
  users User[]
  requests Request[]
  stocks Stock[]
}

model Bahan {
  id String @id @default(cuid())
  nama String @unique
  stok Int @default(0)
  satuan String
  requests Request[]
  stocks Stock[]
}

model Request {
  id String @id @default(cuid())
  bahanId String
  bahanNama String
  jumlah Int
  jumlahDisetujui Int?
  status RequestStatus @default(PENDING)
  userId String
  userName String
  lokasiId String?
  catatan String?
  respon String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bahan Bahan @relation(fields: [bahanId], references: [id])
  user User @relation(fields: [userId], references: [id])
  lokasi Lokasi? @relation(fields: [lokasiId], references: [id])
}

model Stock {
  id String @id @default(cuid())
  bahanId String
  lokasiId String
  jumlah Int @default(0)

  bahan Bahan @relation(fields: [bahanId], references: [id])
  lokasi Lokasi @relation(fields: [lokasiId], references: [id])

  @@unique([bahanId, lokasiId], name: "bahanId_lokasiId")
}